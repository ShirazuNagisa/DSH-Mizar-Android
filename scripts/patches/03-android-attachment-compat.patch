+    // ── Android compatibility: the pre-upload.* attachment wire ────────────
+    // Android's first attachment client speaks attachment.*; upstream 0.8.9
+    // settled on upload.*. These aliases keep that phone working while it
+    // migrates, without a second staging store or a second limit to disagree
+    // with. They are deliberately thin: every byte still goes through the
+    // upstream UploadStore and its quotas, TTL and integrity checks.
+    'attachment.capabilities': async () => {
+      const limits = uploadStore.capabilities()
+      return {
+        version: 1,
+        maxFileBytes: limits.fileBytes,
+        maxImageBytes: limits.imageBytes,
+        maxAttachments: limits.attachments,
+        chunkBytes: limits.chunkBytes,
+        expiresSeconds: limits.expiresSeconds,
+        imageMediaTypes: limits.imageMediaTypes,
+      }
+    },
+
+    'attachment.begin': async (payload, context) => {
+      const record = payload as Record<string, unknown>
+      const kind = record['kind']
+      if (kind !== 'image' && kind !== 'file') {
+        throw new MethodError('MALFORMED_FRAME', 'attachment.begin: payload."kind" must be "image" or "file"')
+      }
+      const byteSize = record['bytes']
+      if (typeof byteSize !== 'number' || !Number.isFinite(byteSize) || byteSize <= 0) {
+        throw new MethodError('MALFORMED_FRAME', 'attachment.begin: payload."bytes" must be a positive number')
+      }
+      const mediaType = optionalString(payload, 'mediaType') ??
+        (kind === 'image' ? 'image/png' : 'application/octet-stream')
+      const sha256 = optionalString(payload, 'sha256')
+      const begun = await uploadStore.begin(context.deviceId, {
+        sessionId: requireString(payload, 'sessionId', 'attachment.begin'),
+        kind,
+        name: requireString(payload, 'name', 'attachment.begin'),
+        mediaType,
+        byteSize,
+        ...(sha256 === undefined ? {} : { sha256 }),
+      })
+      return { uploadId: begun.uploadId, chunkBytes: begun.chunkBytes, offset: 0 }
+    },
+
+    'attachment.chunk': async (payload, context) => {
+      const record = payload as Record<string, unknown>
+      const offset = record['offset']
+      if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+        throw new MethodError('MALFORMED_FRAME', 'attachment.chunk: payload."offset" must be a non-negative integer')
+      }
+      const uploadId = requireString(payload, 'uploadId', 'attachment.chunk')
+      const data = requireString(payload, 'data', 'attachment.chunk')
+      const chunkBytes = uploadStore.capabilities().chunkBytes
+      if (offset % chunkBytes !== 0) {
+        throw new MethodError('MALFORMED_FRAME', 'attachment.chunk: offset is not on a chunk boundary')
+      }
+      await uploadStore.chunk(context.deviceId, {
+        uploadId,
+        index: offset / chunkBytes,
+        data,
+      })
+      return { offset: offset + Buffer.from(data, 'base64').length }
+    },
+
+    'attachment.finish': async (payload, context) => {
+      const finished = await uploadStore.finish(
+        context.deviceId,
+        requireString(payload, 'uploadId', 'attachment.finish'),
+      )
+      return {
+        attachmentId: finished.attachmentId,
+        name: finished.name,
+        bytes: finished.byteSize,
+        kind: finished.kind,
+        mediaType: finished.mediaType,
+      }
+    },
+
+    'attachment.abort': async (payload, context) => {
+      await uploadStore.abort(context.deviceId, requireString(payload, 'uploadId', 'attachment.abort'))
+      return { aborted: true }
+    },
+
     /** Interrupt the running turn. */
     'session.cancel': async (payload) =>
       cancelSession(ctx, requireString(payload, 'sessionId', 'session.cancel')),
